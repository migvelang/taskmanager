rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de boletas: cada usuario sube bajo su propia carpeta.
    // Lectura permitida a cualquier usuario con sesión (para ver la boleta en el reporte).
    match /boletas/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 12 * 1024 * 1024;
    }
  }
}
