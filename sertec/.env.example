# Copia este archivo a .env y ajusta los valores.

# Base de datos. Local (SQLite) por defecto si se omite:
# DATABASE_URL=sqlite:///./sertec.db
# Producción (Postgres):
# DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/sertec

# Clave para firmar las cookies de sesión (usa una aleatoria larga en prod).
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Usuario administrador inicial (se crea solo la primera vez).
ADMIN_EMAIL=admin@sertec.local
ADMIN_PASSWORD=admin1234

# Umbral en días para la alerta de "envejecimiento / sin avance".
DIAS_SIN_AVANCE=5
